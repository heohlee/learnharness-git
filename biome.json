{
	"$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
	"files": {
		"includes": [
			"src/**",
			"tests/**",
			"scripts/**",
			"*.json",
			"*.md",
			"!package-lock.json",
			"!scripts/install-plugin-local.mjs"
		]
	},
	"formatter": { "indentStyle": "tab", "lineWidth": 120 },
	"linter": { "enabled": true, "rules": { "preset": "recommended" } }
}
